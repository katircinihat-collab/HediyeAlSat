rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return signedIn() && request.auth.token.email is string;
    }

    function isOwnerUid(uid) {
      return signedIn() && uid == request.auth.uid;
    }

    function isOwnerEmail(email) {
      return hasEmail() && email == request.auth.token.email;
    }

    function isAdmin() {
      let adminPath = /databases/$(database)/documents/admins/$(request.auth.token.email);
      return hasEmail()
        && exists(adminPath)
        && (!("aktif" in get(adminPath).data) || get(adminPath).data.aktif != false);
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function ownsOrder(data) {
      return hasEmail()
        && (("alici" in data && data.alici == request.auth.token.email)
          || ("satici" in data && data.satici == request.auth.token.email)
          || ("kullanici" in data && data.kullanici == request.auth.token.email));
    }

    function validOrderCreate() {
      return hasEmail()
        && request.resource.data.keys().hasOnly([
          "ilanId", "ilanBaslik", "magazaId", "satici", "alici",
          "fiyat", "adet", "toplam", "adSoyad", "telefon", "adres",
          "il", "ilce", "kargo", "siparisNotu", "durum", "odemeDurumu",
          "kargoNo", "teslimEdildi", "tarih", "olusturmaTarihi"
        ])
        && request.resource.data.alici == request.auth.token.email
        && request.resource.data.alici != request.resource.data.satici
        && request.resource.data.ilanId is string
        && exists(/databases/$(database)/documents/ilanlar/$(request.resource.data.ilanId))
        && get(/databases/$(database)/documents/ilanlar/$(request.resource.data.ilanId)).data.onay == true
        && request.resource.data.satici == get(/databases/$(database)/documents/ilanlar/$(request.resource.data.ilanId)).data.sahip
        && request.resource.data.fiyat == get(/databases/$(database)/documents/ilanlar/$(request.resource.data.ilanId)).data.fiyat
        && request.resource.data.fiyat is number
        && request.resource.data.fiyat >= 0
        && (!("adet" in request.resource.data)
          || (request.resource.data.adet is number && request.resource.data.adet > 0))
        && (!("toplam" in request.resource.data)
          || request.resource.data.toplam == request.resource.data.fiyat * request.resource.data.adet)
        && request.resource.data.durum == "Ödeme Bekleniyor"
        && request.resource.data.odemeDurumu == false;
    }

    function validSponsorPackage() {
      return (request.resource.data.paketId == "standart"
          && request.resource.data.paketAdi == "Standart Sponsor"
          && request.resource.data.paketFiyati == 499
          && request.resource.data.sponsorSuresi == 7)
        || (request.resource.data.paketId == "premium"
          && request.resource.data.paketAdi == "Premium Sponsor"
          && request.resource.data.paketFiyati == 999
          && request.resource.data.sponsorSuresi == 15)
        || (request.resource.data.paketId == "vip"
          && request.resource.data.paketAdi == "VIP Sponsor"
          && request.resource.data.paketFiyati == 1999
          && request.resource.data.sponsorSuresi == 30);
    }

    function emailOwnedCreate() {
      return hasEmail()
        && request.resource.data.kullanici == request.auth.token.email;
    }

    function emailOwnedExisting() {
      return hasEmail()
        && resource.data.kullanici == request.auth.token.email;
    }

    function listingOwner() {
      return signedIn()
        && (
          (("sahipUid" in resource.data) && resource.data.sahipUid == request.auth.uid)
          || (("sahip" in resource.data) && isOwnerEmail(resource.data.sahip))
        );
    }

    function storeOwner(storeId) {
      return signedIn()
        && (
          (("sahipUid" in resource.data) && resource.data.sahipUid == request.auth.uid)
          || (("sahip" in resource.data) && isOwnerEmail(resource.data.sahip))
          || (hasEmail() && storeId == request.auth.token.email)
        );
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /profiller/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow create: if isOwnerUid(uid)
        && request.resource.data.keys().hasOnly([
          "ad", "telefon", "sehir", "hakkinda"
        ]);
      allow update: if isOwnerUid(uid)
        && onlyChanged(["ad", "telefon", "sehir", "hakkinda"]);
      allow delete: if isOwnerUid(uid);
    }

    match /users/{uid} {
      allow read: if isOwnerUid(uid) || isAdmin();
      allow create: if isOwnerUid(uid)
        && request.resource.data.keys().hasOnly([
          "ad", "displayName", "email", "telefon", "sehir",
          "hakkinda", "photoURL", "createdAt", "updatedAt"
        ])
        && (!("email" in request.resource.data)
          || request.resource.data.email == request.auth.token.email);
      allow update: if isOwnerUid(uid)
        && onlyChanged([
          "ad", "displayName", "email", "telefon", "sehir",
          "hakkinda", "photoURL", "updatedAt"
        ])
        && (!("email" in request.resource.data)
          || request.resource.data.email == request.auth.token.email);
      allow delete: if isOwnerUid(uid);
    }

    match /sepet/{cartId} {
      allow read: if emailOwnedExisting();
      allow create: if emailOwnedCreate();
      allow update: if emailOwnedExisting()
        && request.resource.data.kullanici == resource.data.kullanici;
      allow delete: if emailOwnedExisting();
    }

    match /favoriler/{favoriteId} {
      allow read: if emailOwnedExisting();
      allow create: if emailOwnedCreate();
      allow update: if emailOwnedExisting()
        && request.resource.data.kullanici == resource.data.kullanici;
      allow delete: if emailOwnedExisting();
    }

    match /mesajlar/{messageId} {
      allow read: if hasEmail()
        && (resource.data.gonderen == request.auth.token.email
          || resource.data.alan == request.auth.token.email);

      allow create: if hasEmail()
        && request.resource.data.gonderen == request.auth.token.email
        && request.resource.data.alan is string
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() <= 5000
        && request.resource.data.okundu == false;

      allow update: if hasEmail()
        && resource.data.alan == request.auth.token.email
        && onlyChanged(["okundu"])
        && request.resource.data.okundu is bool;

      allow delete: if false;
    }

    match /ilanlar/{listingId} {
      allow read: if resource.data.onay == true || listingOwner() || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "ilanNo", "baslik", "fiyat", "eskiFiyat", "kategori",
          "altKategori", "tip", "sehir", "telefon", "adet", "stok",
          "marka", "renk", "aciklama", "resim", "resimler", "video",
          "ozelGunler", "sahipUid", "sahip", "magazaId", "magazaAdi",
          "paraBirimi", "puan", "yorumSayisi", "favoriSayisi",
          "satisSayisi", "goruntulenme", "onay", "oneCikan", "trend",
          "kampanyali", "indirim", "ucretsizKargo", "ayniGunKargo",
          "guvenliOdeme", "kargoUcreti", "teslimatSuresi", "aktif", "tarih",
          "urunTipi", "dosyaFormatlari", "dijitalTeslimat",
          "fizikselKargo", "hakOnayi",
          "hakOnayiTarihi", "hakOnayiSurumu", "dijitalDosyaDurumu"
        ])
        && request.resource.data.sahipUid == request.auth.uid
        && request.resource.data.sahip == request.auth.token.email
        && request.resource.data.onay == false
        && request.resource.data.trend == false
        && request.resource.data.oneCikan == false
        && request.resource.data.kampanyali == false
        && request.resource.data.puan == 5
        && request.resource.data.yorumSayisi == 0
        && request.resource.data.favoriSayisi == 0
        && request.resource.data.satisSayisi == 0
        && request.resource.data.goruntulenme == 0
        && request.resource.data.guvenliOdeme == true
        && ((!("urunTipi" in request.resource.data)
            && !request.resource.data.keys().hasAny([
              "dosyaFormatlari", "dijitalTeslimat", "fizikselKargo", "hakOnayi",
              "hakOnayiTarihi", "hakOnayiSurumu", "dijitalDosyaDurumu"
            ]))
          || (("urunTipi" in request.resource.data)
            && request.resource.data.urunTipi == "dijital"
            && request.resource.data.kategori == "A4 Tasarım"
            && request.resource.data.dosyaFormatlari is list
            && request.resource.data.dijitalTeslimat == true
            && request.resource.data.fizikselKargo == false
            && request.resource.data.hakOnayi == true
            && request.resource.data.hakOnayiTarihi is timestamp
            && request.resource.data.hakOnayiSurumu == "digital-rights-v1"
            && request.resource.data.dijitalDosyaDurumu == "bekleniyor"));

      allow update: if isAdmin()
        || (listingOwner() && onlyChanged([
          "baslik", "fiyat", "telefon", "aciklama", "kategori",
          "altKategori", "renk", "marka", "resim", "resimler",
          "video", "ozelGunler", "tip", "sehir", "adet", "stok",
          "eskiFiyat", "indirim", "ucretsizKargo", "ayniGunKargo",
          "kargoUcreti", "teslimatSuresi", "aktif", "paraBirimi"
        ]));

      allow delete: if listingOwner() || isAdmin();
    }

    // Provider identifiers and protected originals are backend-only.
    match /digitalAssets/{assetId} {
      allow read, create, update, delete: if false;
    }

    match /tasarimOylari/{voteId} {
      allow read, create, update, delete: if false;
    }

    // Günün kapışması ve oyları yalnız doğrulanmış backend/Admin SDK tarafından yönetilir.
    match /giftBattles/{battleId} {
      allow read, create, update, delete: if false;
    }

    match /giftBattleVotes/{voteId} {
      allow read, create, update, delete: if false;
    }

    match /orderClaims/{claimId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.buyerUid == request.auth.uid
          || resource.data.sellerUid == request.auth.uid
          || (hasEmail() && resource.data.buyerEmail == request.auth.token.email)
          || (hasEmail() && resource.data.sellerEmail == request.auth.token.email)));
      allow create, update, delete: if false;
    }

    match /orderClaimGuards/{orderId} {
      allow read, create, update, delete: if false;
    }

    match /refundFinalizations/{refundId} {
      allow read, create, update, delete: if false;
    }

    match /magazalar/{storeId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "sahipUid", "sahip", "magazaAdi", "telefon", "sehir",
          "aciklama", "logo", "kapak", "puan", "takipci", "tarih"
        ])
        && request.resource.data.sahipUid == request.auth.uid
        && request.resource.data.sahip == request.auth.token.email
        && request.resource.data.puan == 5
        && request.resource.data.takipci == 0;

      allow update: if isAdmin()
        || (storeOwner(storeId) && onlyChanged([
          "magazaAdi", "adi", "logo", "kapak", "banner",
          "telefon", "sehir", "aciklama"
        ]));

      allow delete: if isAdmin();
    }

    match /yorumlar/{reviewId} {
      allow read: if true;
      allow create: if emailOwnedCreate()
        && request.resource.data.ilanId is string
        && request.resource.data.puan is number
        && request.resource.data.puan >= 1
        && request.resource.data.puan <= 5
        && request.resource.data.yorum is string
        && request.resource.data.yorum.size() >= 3
        && request.resource.data.yorum.size() <= 2000;
      allow update: if false;
      allow delete: if emailOwnedExisting() || isAdmin();
    }

    match /magazaPuanlari/{ratingId} {
      allow read: if true;
      allow create: if emailOwnedCreate()
        && request.resource.data.magazaId is string
        && request.resource.data.puan is number
        && request.resource.data.puan >= 1
        && request.resource.data.puan <= 5;
      allow update: if false;
      allow delete: if emailOwnedExisting() || isAdmin();
    }

    match /magazaYorumlari/{reviewId} {
      allow read: if true;
      allow create: if emailOwnedCreate()
        && request.resource.data.magazaId is string
        && request.resource.data.yorum is string
        && request.resource.data.yorum.size() >= 1
        && request.resource.data.yorum.size() <= 2000
        && (!("puan" in request.resource.data)
          || (request.resource.data.puan is number
            && request.resource.data.puan >= 1
            && request.resource.data.puan <= 5));
      allow update: if false;
      allow delete: if emailOwnedExisting() || isAdmin();
    }

    match /takipciler/{followId} {
      allow read: if emailOwnedExisting() || isAdmin();
      allow create: if emailOwnedCreate()
        && request.resource.data.magazaId is string;
      allow update: if false;
      allow delete: if emailOwnedExisting() || isAdmin();
    }

    match /takipler/{followId} {
      allow read: if true;
      allow create: if emailOwnedCreate()
        && request.resource.data.magaza is string;
      allow update: if false;
      allow delete: if emailOwnedExisting() || isAdmin();
    }

    match /siparisler/{orderId} {
      allow read: if ownsOrder(resource.data) || isAdmin();
      allow create: if validOrderCreate();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /odemeler/{paymentId} {
      allow read: if (hasEmail() && resource.data.kullanici == request.auth.token.email)
        || isAdmin();
      allow create, update, delete: if false;
    }

    match /wallets/{walletId} {
      allow read: if isAdmin()
        || (hasEmail()
          && (walletId == request.auth.token.email
            || resource.data.email == request.auth.token.email));
      allow create, update, delete: if false;
    }

    match /bakiyeHareketleri/{movementId} {
      allow read: if isAdmin()
        || (hasEmail() && resource.data.satici == request.auth.token.email);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /paraCekmeTalepleri/{requestId} {
      allow read: if isAdmin()
        || (hasEmail() && resource.data.email == request.auth.token.email);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /geriCekmeTalepleri/{requestId} {
      allow read: if isAdmin()
        || (hasEmail() && resource.data.email == request.auth.token.email);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /cekmeTalepleri/{requestId} {
      allow read: if isAdmin()
        || (hasEmail() && resource.data.satici == request.auth.token.email);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /withdrawRequests/{requestId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin();
    }

    match /sponsorBasvurular/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.kullaniciId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "magazaAdi", "yetkiliAdi", "telefon", "email", "webSitesi",
          "hakkinda", "kullaniciId", "paketId", "paketAdi", "paketFiyati",
          "sponsorSuresi", "durum", "odemeDurumu", "odemeTarihi",
          "basvuruTarihi", "okunmadi"
        ])
        && request.resource.data.kullaniciId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && validSponsorPackage()
        && request.resource.data.durum == "Ödeme Bekliyor"
        && request.resource.data.odemeDurumu == false
        && request.resource.data.odemeTarihi == null
        && request.resource.data.okunmadi == true;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
