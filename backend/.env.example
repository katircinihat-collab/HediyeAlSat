PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-admin.json
# Alternatif: FIREBASE_SERVICE_ACCOUNT_JSON tek satır JSON olarak secret store'da tutulabilir.
# Sandbox dışında global alıcı kimliği kullanılmaz.
IYZIPAY_SANDBOX_BUYER_IDENTITY_NUMBER=11111111111
# 32 byte rastgele anahtarın Base64 karşılığı (server-only).
BUYER_IDENTITY_ENCRYPTION_KEY=
MAINTENANCE_CRON_SECRET=
MAINTENANCE_BASE_URL=https://your-backend-service.onrender.com

# Cloudinary protected originals (server only; never use VITE_ prefixes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
